; RUN: llc -mtriple=x86_64-unknown-linux-gnu < %s | FileCheck %s

declare preserve_mostcc i64 @preserve_most_callee(i64 %x, i64 %y)
declare preserve_mostcc i64 @preserve_most_callee_4args(i64 %x1, i64 %x2, i64 %x3, i64 %x4)

; Test 1: Argument reuse with no spills.
; a (R12) and b (R13) are passed to callee (RDI, RSI) and reused after the call.
; Since R12/R13 are preserved by preserve_most, they should remain in R12/R13 with 0 spills.
define tail_chaincc i64 @tail_chain_caller_reuse(i64 %a, i64 %b) {
; CHECK-LABEL: tail_chain_caller_reuse:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    movq %r13, %rsi
; CHECK-NEXT:    movq %r12, %rdi
; CHECK-NEXT:    callq preserve_most_callee@PLT
; CHECK-NEXT:    addq %r12, %rax
; CHECK-NEXT:    addq %r13, %rax
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq $8
entry:
  %val = call preserve_mostcc i64 @preserve_most_callee(i64 %a, i64 %b)
  %sum1 = add i64 %a, %b
  %res = add i64 %sum1, %val
  ret i64 %res
}

; Test 2: Within budget (total 12 args) with no spills.
