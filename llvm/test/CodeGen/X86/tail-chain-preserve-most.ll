; a5 (R11) and a8 (RCX) must be moved because they are not preserved or clobbered.
; They should be moved to free preserved registers (R10, RBX) with 0 spills.
define tail_chaincc i64 @tail_chain_caller_budget(
; CHECK-LABEL: tail_chain_caller_budget:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    movq %rcx, %r10
; CHECK-NEXT:    movq %r11, %rbx
; CHECK-NEXT:    movq %r15, %rcx
; CHECK-NEXT:    movq %r14, %rdx
; CHECK-NEXT:    movq %r13, %rsi
; CHECK-NEXT:    movq %r12, %rdi
; CHECK-NEXT:    callq preserve_most_callee_4args@PLT
; CHECK-NEXT:    addq %r9, %rbx
; CHECK-NEXT:    addq %r8, %r10
; CHECK-NEXT:    addq %rbx, %r10
; CHECK-NEXT:    addq %r10, %rax
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq $8
    i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6, i64 %a7, i64 %a8) {
entry:
  %val = call preserve_mostcc i64 @preserve_most_callee_4args(i64 %a1, i64 %a2, i64 %a3, i64 %a4)
  %s1 = add i64 %a5, %a6
  %s2 = add i64 %s1, %a7
  %s3 = add i64 %s2, %a8
  %res = add i64 %s3, %val
  ret i64 %res
}

